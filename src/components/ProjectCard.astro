---
import Pill from './Pill.astro'
export interface Props {
  title: string
  description: string
  tech: string[]
}
const {title, tech, description} = Astro.props
---

<div class="bg-[#1b1b1d] my-4 rounded-sm px-2 py-4">
  <div class="flex flex-row justify-between gap-4 mb-2">
    <h2 class="text-xl">{title}</h2>
    <a class="text-gray-700"  href="">Github</a>
  </div>
  <div class="flex flex-row gap-8">
    <div class="sm: bg-red-700 sm:w-32 sm:h-32 "></div>
    <div class="text-left ">
      <p class="mb-2 max-w-lg">{description}</p>
      <div class="flex gap-2">
        {tech.map((tech) => (<Pill>{tech}</Pill>))}
      </div>
    </div>
  </div>
</div>

