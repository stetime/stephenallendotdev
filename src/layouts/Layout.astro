---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { Font } from "astro:assets";
const { title, description } = Astro.props;
const url = new URL(Astro.url, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-sans" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description ||
        "Stephen Allen - web developer, tinkerer and self hoster"}
    />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description ||
        "Stephen Allen - web developer, tinkerer and self hoster"}
    />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stephen Allen" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link
      rel="alternate"
      href="rss.xml"
      type="application/rss+xml"
      title="Stephen Allen"
    />
    <meta name="theme-color" content="#86ff4e" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <div class="container">
      <slot />
    </div>
  </body>
</html>
