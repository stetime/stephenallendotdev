---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="prose">
    <h1>About</h1>
    <hr class="title-rule" />
    <p>
      Web developer & sysadmin from Manchester, UK. 
    </p>
    <p>
      I find the online discourse around LLMs and the culture wars utterly disinteresting, so
      look literally anywhere else on the internet for that kind of content.
    </p>
    <p>
      This website was built with <a href="https://www.astro.build">Astro</a>.
    </p>
    <hr class="text-rule" />
  </div>
</Layout>
